# 复制为 .env 后按需修改;全部留空/不建 .env 时按 dev 默认一键起(仅限本机演示)。
# docker compose up -d --build 后访问 http://localhost:${WEB_PORT}

# 前端对外端口
WEB_PORT=8081

# 数据库 root 口令(mysql 容器与后端共用)
DB_PASSWORD=root

# 生产部署三件套(prod 必改):
#   SPRING_PROFILES_ACTIVE=prod   关闭 swagger/api-docs
#   JWT_SECRET=<至少32字节随机串>  后端启动时强校验长度
#   ADMIN_PASSWORD=<新管理员口令>  启动时重置种子里的 admin/admin123
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=dev-only-insecure-secret-change-me-32+chars
ADMIN_PASSWORD=

# prod 必须设为前端域名白名单(逗号分隔);dev 全开
CORS_ALLOWED_ORIGINS=*
