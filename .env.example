# 变量清单/口径说明。⚠ 别手抄:正常路径是 bash deploy/gen-env.sh <公网IP或域名> 一把生成 .env
# (随机强口令 + prod profile)。本机演示同样如此,host 填 localhost。
# 除 VIEWER_PASSWORD 外全部必填:留空则 docker compose up 直接报错退出(fail-closed),
# 这是有意为之——历史上的可用默认值让"零配置 up"起出过弱口令可写实例。

# 前端对外端口(可选,默认 8081;gen-env.sh 生成的是 80)
WEB_PORT=8081

# 【必填】数据库 root 口令(mysql 容器与后端共用)。改过之后老数据卷里仍是旧口令,见部署指南第 6 节
DB_PASSWORD=

# 【必填】prod=关闭 swagger/api-docs;仅本地调试才填 dev
SPRING_PROFILES_ACTIVE=prod

# 【必填】至少 32 字节随机串,后端启动时强校验长度。手工生成: openssl rand -base64 48
# 此处刻意不给示例值:任何写进仓库的密钥都等同公开
JWT_SECRET=

# 【必填】新管理员口令,启动时重置种子里的 admin/admin123(种子被 20+ 个测试依赖,删不掉,只能覆盖)
ADMIN_PASSWORD=

# 只读账号(viewer,GET-only):非空=启动时创建/重置;留空=不创建。唯一可留空项。适合发给测试/领导只看不改
VIEWER_PASSWORD=

# 【必填】前端域名白名单(逗号分隔),如 http://1.2.3.4 或 https://park.example.com。别填 * (等于不设防)
CORS_ALLOWED_ORIGINS=
